# ==============================================================================
# X-VIBE-SHOP — Environment variables
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# JANGAN pernah commit `.env.local`.
# ==============================================================================

# --- Supabase ---------------------------------------------------------------
# URL project (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable / anon key (aman dipakai di browser, dilindungi RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Secret / service-role key (HANYA server-side, jangan pernah expose ke browser)
SUPABASE_SECRET_KEY=<service-role-key>

# --- Aplikasi ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payment Gateway (Midtrans) ---------------------------------------------
# Server Key (rahasia, HANYA server-side). Sandbox diawali "SB-Mid-server-".
MIDTRANS_SERVER_KEY=

# Client Key (publik, dipakai Snap.js di browser). Sandbox: "SB-Mid-client-".
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# "true" untuk produksi, "false"/kosong untuk sandbox.
MIDTRANS_IS_PRODUCTION=false

# Dipakai halaman order untuk memilih mode tampilan (opsional).
PAYMENT_PROVIDER=midtrans
